{
  "expo": {
    "name": "FitMax",
    "slug": "fitmax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fitmax-icon.png",
    "scheme": "fitmax",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/fitmax-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0F12",
          "image": "./assets/images/fitmax-splash.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
